{
  "name": "seiton-social-orchestrator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @seiton/web --filter @seiton/worker dev",
    "build": "pnpm --filter @seiton/shared build && pnpm --filter @seiton/worker build && pnpm --filter @seiton/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "cf:build": "node cloudflare/build-cf.mjs",
    "cf:deploy": "node cloudflare/build-cf.mjs && npx wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.14.0",
    "eslint": "^9.23.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
